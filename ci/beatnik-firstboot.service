[Unit]
Description=Beatnik OS first boot setup (Docker + Beatnik Controller)
After=network-online.target docker.service time-sync.target
Wants=network-online.target docker.service time-sync.target
ConditionPathExists=!/etc/beatnik/firstboot.done

[Service]
Type=oneshot
ExecStart=/opt/beatnik/firstboot.sh
RemainAfterExit=yes
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target